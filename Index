/* ============================================================
   ФОН ОТКРЫТКИ
   ============================================================ */
const GRADIENTS = [
  ['#6a5acd', '#ff9500'],
  ['#007aff', '#34c759'],
  ['#ff3b30', '#ff9500'],
  ['#1c1c1e', '#6a5acd'],
  ['#34c759', '#007aff'],
  ['#ff2d55', '#ff9500']
];

const BG_STORAGE_KEY = 'abrakadabra_bg';

function getCustomBg() {
  try { return localStorage.getItem(BG_STORAGE_KEY); } catch (e) { return null; }
}

function setCustomBg(dataUrl) {
  try {
    if (dataUrl) localStorage.setItem(BG_STORAGE_KEY, dataUrl);
    else localStorage.removeItem(BG_STORAGE_KEY);
  } catch (e) {
    showToast('Не удалось сохранить фон (мало места)');
  }
}

function updateBgUI() {
  const custom = getCustomBg();
  const preview = document.getElementById('bgPreview');
  const name = document.getElementById('bgName');
  const sub = document.getElementById('bgSub');
  const clearBtn = document.getElementById('bgClearBtn');

  if (custom) {
    preview.style.backgroundImage = `url("${custom}")`;
    name.textContent = 'Свой фон';
    sub.textContent = 'Загружен из галереи';
    clearBtn.classList.remove('hidden');
  } else {
    preview.style.backgroundImage = '';
    preview.style.background = 'linear-gradient(135deg, #6a5acd, #ff9500)';
    name.textContent = 'Градиент';
    sub.textContent = 'Случайный из 6 вариантов';
    clearBtn.classList.add('hidden');
  }
}

function handleBgUpload(file) {
  if (!file) return;
  if (!file.type.startsWith('image/')) {
    showToast('Нужен файл изображения');
    return;
  }
  if (file.size > 5 * 1024 * 1024) {
    showToast('Файл больше 5 МБ');
    return;
  }
  const reader = new FileReader();
  reader.onload = (e) => {
    // Сжимаем до 1200px по длинной стороне, чтобы влезло в localStorage
    const img = new Image();
    img.onload = () => {
      const maxSide = 1200;
      let w = img.width, h = img.height;
      if (Math.max(w, h) > maxSide) {
        const k = maxSide / Math.max(w, h);
        w = Math.round(w * k);
        h = Math.round(h * k);
      }
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);
      const dataUrl = canvas.toDataURL('image/jpeg', 0.82);
      setCustomBg(dataUrl);
      updateBgUI();
      showToast('Фон сохранён');
    };
    img.onerror = () => showToast('Не удалось прочитать изображение');
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

/* ============================================================
   ГЕНЕРАЦИЯ
   ============================================================ */
let lastResult = '';
let lastWords = [];
let lastLinesCount = 4;

function getSelectedLines() {
  const checked = document.querySelector('input[name="lines"]:checked');
  return checked ? parseInt(checked.value, 10) : 4;
}

function generate(wordsOverride, linesOverride) {
  const input = document.getElementById('words');
  const resultEl = document.getElementById('result');
  const resultCard = document.getElementById('resultCard');

  const linesCount = linesOverride || getSelectedLines();

  let words;
  if (wordsOverride) {
    words = wordsOverride;
  } else {
    const raw = input.value.trim();
    if (!raw) { showToast('Введите 2–3 слова'); return; }
    words = raw.split(/\s+/).filter(w => w.length > 0);
    if (words.length < 2 || words.length > 3) {
      showToast('Нужно 2 или 3 слова');
      return;
    }
  }

  if (linesCount === 2 && words.length !== 2) {
    showToast('Для 2 строк нужно ровно 2 слова');
    return;
  }

  lastWords = words;
  lastLinesCount = linesCount;

  const rhymes = buildRhymes(words);
  const template = getTemplate(words.length, linesCount);

  let lines;
  if (words.length === 2) {
    const [a, b] = words;
    const [ra, rb] = rhymes.map(r => r.word);
    lines = template(a, b, ra, rb);
  } else {
    const [a, b, c] = words;
    const [ra, rb, rc] = rhymes.map(r => r.word);
    lines = template(a, b, c, ra, rb, rc);
  }

  lastResult = lines.join('\n');
  render(resultEl, resultCard, lastResult);
}

function render(resultEl, resultCard, text) {
  resultEl.textContent = text;
  resultEl.classList.remove('visible');
  void resultEl.offsetWidth;
  resultEl.classList.add('visible');
  resultCard.classList.remove('hidden');
}

/* ============================================================
   ПОДЕЛИТЬСЯ
   ============================================================ */
let pendingShareText = '';

function openShareSheet() {
  if (!lastResult) { showToast('Сначала создайте стих'); return; }
  pendingShareText = lastResult + '\n\n✨ Создано в Абракадабра-Рифмовалке';
  document.getElementById('shareSheet').classList.add('show');
}

function closeShareSheet() {
  document.getElementById('shareSheet').classList.remove('show');
}

function doShare(target) {
  const text = pendingShareText;
  if (!text) return;
  const encoded = encodeURIComponent(text);

  let url = null;
  if (target === 'telegram') url = `https://t.me/share/url?url=${encoded}&text=${encoded}`;
  else if (target === 'whatsapp') url = `https://wa.me/?text=${encoded}`;
  else if (target === 'vk') url = `https://vk.com/share.php?comment=${encoded}`;

  if (url) {
    window.open(url, '_blank', 'noopener');
    closeShareSheet();
    return;
  }
  if (target === 'copy') {
    copyToClipboard(text);
    closeShareSheet();
  }
}

function copyToClipboard(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text)
      .then(() => showToast('Стих скопирован!'))
      .catch(() => fallbackCopy(text));
  } else {
    fallbackCopy(text);
  }
}

function fallbackCopy(text) {
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  ta.style.top = '0';
  ta.style.left = '0';
  document.body.appendChild(ta);
  try {
    ta.focus();
    ta.setSelectionRange(0, 999999);
    document.execCommand('copy');
    showToast('Стих скопирован!');
  } catch (e) {
    showToast('Не удалось скопировать');
  } finally {
    document.body.removeChild(ta);
  }
}

/* ============================================================
   ОТКРЫТКА (canvas → PNG)
   ============================================================ */
const POSTCARD_W = 1080;
const POSTCARD_H = 1350; // 4:5 — идеально для соцсетей

function wrapText(ctx, text, maxWidth) {
  const words = text.split(' ');
  const lines = [];
  let current = '';
  for (const w of words) {
    const test = current ? current + ' ' + w : w;
    if (ctx.measureText(test).width > maxWidth && current) {
      lines.push(current);
      current = w;
    } else {
      current = test;
    }
  }
  if (current) lines.push(current);
  return lines;
}

function drawCoverImage(ctx, img) {
  const k = Math.max(POSTCARD_W / img.width, POSTCARD_H / img.height);
  const w = img.width * k;
  const h = img.height * k;
  ctx.drawImage(img, (POSTCARD_W - w) / 2, (POSTCARD_H - h) / 2, w, h);
}

async function buildPostcard() {
  const canvas = document.createElement('canvas');
  canvas.width = POSTCARD_W;
  canvas.height = POSTCARD_H;
  const ctx = canvas.getContext('2d');

  const customBg = getCustomBg();

  if (customBg) {
    // Свой фон: загружаем картинку и рисуем cover
    const img = await new Promise((resolve, reject) => {
      const i = new Image();
      i.onload = () => resolve(i);
      i.onerror = reject;
      i.src = customBg;
    });
    drawCoverImage(ctx, img);
    // Затемнение для читаемости
    ctx.fillStyle = 'rgba(0,0,0,0.45)';
    ctx.fillRect(0, 0, POSTCARD_W, POSTCARD_H);
  } else {
    // Случайный градиент
    const [c1, c2] = pick(GRADIENTS);
    const grad = ctx.createLinearGradient(0, 0, POSTCARD_W, POSTCARD_H);
    grad.addColorStop(0, c1);
    grad.addColorStop(1, c2);
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, POSTCARD_W, POSTCARD_H);
  }

  // Декоративные звёзды
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  for (let i = 0; i < 40; i++) {
    const x = Math.random() * POSTCARD_W;
    const y = Math.random() * POSTCARD_H;
    const r = Math.random() * 2.5 + 0.5;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  }

  // Текст стиха
  const lines = lastResult.split('\n');
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillStyle = '#ffffff';
  ctx.shadowColor = 'rgba(0,0,0,0.5)';
  ctx.shadowBlur = 12;
  ctx.shadowOffsetY = 2;

  // Подбираем шрифт под количество строк
  let fontSize;
  if (lines.length <= 2) fontSize = 72;
  else if (lines.length <= 4) fontSize = 62;
  else fontSize = 52;

  const maxWidth = POSTCARD_W - 160;
  const lineHeight = fontSize * 1.35;

  // Перенос длинных строк
  const wrapped = [];
  for (const ln of lines) {
    wrapped.push(...wrapText(ctx, ln, maxWidth));
  }

  const totalHeight = wrapped.length * lineHeight;
  let y = (POSTCARD_H - totalHeight) / 2 + lineHeight / 2;

  ctx.font = `600 ${fontSize}px -apple-system, "SF Pro Display", "Segoe UI", Roboto, sans-serif`;

  for (const ln of wrapped) {
    ctx.fillText(ln, POSTCARD_W / 2, y);
    y += lineHeight;
  }

  // Подпись
  ctx.shadowBlur = 6;
  ctx.font = '500 28px -apple-system, "SF Pro Display", "Segoe UI", Roboto, sans-serif';
  ctx.fillStyle = 'rgba(255,255,255,0.85)';
  ctx.fillText('✨ Создано в Абракадабре', POSTCARD_W / 2, POSTCARD_H - 70);

  return canvas.toDataURL('image/png');
}

/* Превью открытки */
let currentPostcardDataUrl = '';

async function openPostcard() {
  if (!lastResult) { showToast('Сначала создайте стих'); return; }
  showToast('Собираем открытку…');
  try {
    currentPostcardDataUrl = await buildPostcard();
    document.getElementById('postcardImg').src = currentPostcardDataUrl;
    document.getElementById('postcardBackdrop').classList.add('show');
  } catch (e) {
    showToast('Не удалось собрать открытку');
  }
}

function closePostcard() {
  document.getElementById('postcardBackdrop').classList.remove('show');
}

async function downloadPostcard() {
  if (!currentPostcardDataUrl) return;
  const filename = 'abrakadabra-postcard.png';
  try {
    const res = await fetch(currentPostcardDataUrl);
    const blob = await res.blob();
    const file = new File([blob], filename, { type: 'image/png' });

    // Нативный шит «Поделиться файлом» на iOS/Android
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      await navigator.share({
        files: [file],
        title: 'Открытка со стихом',
        text: lastResult
      });
      return;
    }

    // Fallback: скачивание
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 2000);
    showToast('Открытка сохранена');
  } catch (e) {
    if (e.name === 'AbortError') return;
    showToast('Не удалось сохранить');
  }
}

/* ============================================================
   ТОСТ
   ============================================================ */
let toastTimer;
function showToast(msg) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
}

/* ============================================================
   ИНИЦИАЛИЗАЦИЯ
   ============================================================ */
document.addEventListener('DOMContentLoaded', () => {
  const input = document.getElementById('words');

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); generate(); }
  });

  document.querySelectorAll('input[name="lines"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const lines = getSelectedLines();
      const raw = input.value.trim();
      const words = raw ? raw.split(/\s+/).filter(Boolean) : [];
      if (lines === 2 && words.length === 3) {
        showToast('Для 2 строк нужно ровно 2 слова');
      }
    });
  });

  document.getElementById('madness').addEventListener('input', updateMadnessUI);

  document.getElementById('moreBtn').addEventListener('click', () => {
    if (lastWords.length) generate(lastWords, lastLinesCount);
  });

  document.getElementById('shareBtn').addEventListener('click', openShareSheet);
  document.getElementById('sheetCancel').addEventListener('click', closeShareSheet);
  document.getElementById('shareSheet').addEventListener('click', (e) => {
    if (e.target.id === 'shareSheet') closeShareSheet();
  });

  document.querySelectorAll('[data-share]').forEach(btn => {
    btn.addEventListener('click', () => doShare(btn.dataset.share));
  });

  // Открытка
  document.getElementById('postcardBtn').addEventListener('click', openPostcard);
  document.getElementById('postcardClose').addEventListener('click', closePostcard);
  document.getElementById('postcardDownload').addEventListener('click', downloadPostcard);
  document.getElementById('postcardBackdrop').addEventListener('click', (e) => {
    if (e.target.id === 'postcardBackdrop') closePostcard();
  });
  document.getElementById('postcardChangeBg').addEventListener('click', () => {
    document.getElementById('bgFile').click();
  });

  // Фон
  document.getElementById('bgUploadBtn').addEventListener('click', () => {
    document.getElementById('bgFile').click();
  });
  document.getElementById('bgFile').addEventListener('change', (e) => {
    handleBgUpload(e.target.files[0]);
    e.target.value = '';
  });
  document.getElementById('bgClearBtn').addEventListener('click', () => {
    setCustomBg(null);
    updateBgUI();
    showToast('Фон сброшен на градиент');
  });

  updateBgUI();
  updateMadnessUI();
});
